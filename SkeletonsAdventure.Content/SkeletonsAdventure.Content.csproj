<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="4.0.0" />
    <ProjectReference Include="..\RpgLibrary\RpgLibrary.csproj" />
  </ItemGroup>

  <Target Name="BuildGameContent" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <GameContentOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'GameAssets'))</GameContentOutput>
      <GameContentCache>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'ContentCache'))</GameContentCache>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(TargetPath)&quot; build -p DesktopGL -g Reach -s Assets -o &quot;$(GameContentOutput)&quot; -i &quot;$(GameContentCache)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          CustomErrorRegularExpression="\[E\] .+" />
    <ItemGroup>
      <GeneratedAsset Include="$(GameContentOutput)/Content/**/*.xnb" />
      <CompiledAsset Include="@(GeneratedAsset)">
        <Link>Content/%(GeneratedAsset.RecursiveDir)%(GeneratedAsset.Filename)%(GeneratedAsset.Extension)</Link>
      </CompiledAsset>
    </ItemGroup>
  </Target>

  <Target Name="GetCompiledAssets" DependsOnTargets="Build;BuildGameContent" Returns="@(CompiledAsset)" />
</Project>
