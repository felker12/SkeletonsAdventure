<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Extended.Content.Pipeline" Version="6.1.1" />
    <ProjectReference Include="..\RpgLibrary\RpgLibrary.csproj" />
  </ItemGroup>

  <Target Name="BuildGameContent" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Extended 6 uses different XNB readers and cache types from the old Tiled pipeline. -->
    <PropertyGroup>
      <GameContentOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'GameAssetsV6'))</GameContentOutput>
      <GameContentCache>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'ContentCacheV6'))</GameContentCache>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(TargetPath)&quot; validate Assets &quot;$(GameContentOutput)/DataAssets.txt&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; build -p DesktopGL -g Reach -s Assets -o &quot;$(GameContentOutput)&quot; -i &quot;$(GameContentCache)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          CustomErrorRegularExpression="\[E\] .+" />
    <ReadLinesFromFile File="$(GameContentOutput)/DataAssets.txt">
      <Output TaskParameter="Lines" ItemName="_DeclaredDataAsset" />
    </ReadLinesFromFile>
    <Error Condition="!Exists('$(GameContentOutput)/Content/%(_DeclaredDataAsset.Identity).xnb')"
           Text="The content build did not produce '%(_DeclaredDataAsset.Identity).xnb'." />
    <ItemGroup>
      <GeneratedAsset Include="$(GameContentOutput)/Content/**/*.xnb" />
      <CompiledAsset Include="@(GeneratedAsset)">
        <Link>Content/%(GeneratedAsset.RecursiveDir)%(GeneratedAsset.Filename)%(GeneratedAsset.Extension)</Link>
      </CompiledAsset>
      <CompiledAsset Include="$(GameContentOutput)/DataAssets.txt" Link="Content/DataAssets.txt" />
    </ItemGroup>
  </Target>

  <Target Name="GetCompiledAssets" DependsOnTargets="Build;BuildGameContent" Returns="@(CompiledAsset)" />
</Project>
